{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@midnight-ntwrk/confidential-voting-api": ["../api/src/index.ts"],
      "@midnight-ntwrk/confidential-voting-contract": ["../contract/src/index.ts"]
    },
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "isolatedModules": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "lib": ["ESNext"],
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["src"]
}
