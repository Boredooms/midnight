{
  "buildCommand": "cd confidential-voting-ui && npm run build && cp -r ../contract/src/managed/confidential-voting/keys ./dist/keys && cp -r ../contract/src/managed/confidential-voting/zkir ./dist/zkir",
  "outputDirectory": "confidential-voting-ui/dist",
  "installCommand": "npm ci --legacy-peer-deps",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/keys/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/zkir/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}