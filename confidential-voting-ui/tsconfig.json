{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@midnight-ntwrk/confidential-voting-api": ["../api/src/index.ts", "../api/dist/index.d.ts"],
      "@midnight-ntwrk/confidential-voting-api/*": ["../api/src/*", "../api/dist/*"],
      "@midnight-ntwrk/confidential-voting-contract": ["../contract/src/index.ts", "../contract/dist/index.d.ts"],
      "@midnight-ntwrk/confidential-voting-contract/*": ["../contract/src/*", "../contract/dist/*"]
    },
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "isolatedModules": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "esModuleInterop": false,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "eslint.config.mjs"]
}
