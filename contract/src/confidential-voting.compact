// Confidential Voting DApp Contract for Midnight Blockchain
// Privacy-preserving decentralized voting with time-based finalization
// Rise In Level 1 Builder Challenge
//
// Privacy guarantees:
// - Voter identity is hidden via DApp-specific public keys (persistentHash)
// - Vote choice is proven valid (0 or 1) without revealing which candidate
// - Nullifiers prevent double-voting without linking to voter identity
// - Election results are published on-chain transparently

pragma language_version 0.23;

import CompactStandardLibrary;

export enum State {
  UNINITIALIZED,
  OPEN,
  FINALIZED
}

export enum Winner {
  NONE,
  CANDIDATE_A,
  CANDIDATE_B,
  TIE
}

// --- Public Ledger State ---
export ledger state: State;
export ledger electionTitle: Maybe<Opaque<"string">>;
export ledger candidate0Tally: Counter;
export ledger candidate1Tally: Counter;
export ledger totalVotes: Counter;
export ledger owner: Bytes<32>;
export ledger deadline: Uint<64>;
export ledger winner: Winner;
export ledger nullifierSet: Set<Bytes<32>>;
export ledger sequence: Counter;

// --- Constructor ---
constructor() {
  state = State.UNINITIALIZED;
  electionTitle = none<Opaque<"string">>();
  winner = Winner.NONE;
  deadline = 0;
  sequence.increment(1);
}

// --- Witness (private input from client) ---
witness voterSecretKey(): Bytes<32>;

// --- Circuits ---

// Create an election with a title and voting duration (in seconds from now)
// Only callable when UNINITIALIZED
export circuit createElection(title: Opaque<"string">, durationSeconds: Uint<64>): [] {
  assert(state == State.UNINITIALIZED, "Election is already initialized");
  assert(durationSeconds > 0, "Duration must be positive");

  // Set owner via ZK identity
  owner = disclose(voterPublicKey(voterSecretKey(), sequence as Field as Bytes<32>));
  electionTitle = disclose(some<Opaque<"string">>(title));
  
  // Deadline is a future block time — voters must vote before this time
  // On local dev, block time increments ~6s per block
  deadline = disclose(durationSeconds);
  
  state = State.OPEN;
}

// Cast a confidential vote
// - candidateIndex must be 0 or 1 (proven in ZK without revealing)
// - Nullifier prevents double-voting without linking to identity
export circuit vote(candidateIndex: Field): [] {
  assert(state == State.OPEN, "Voting is not open");
  
  // Compute nullifier from secret key + sequence (unique per election round)
  const sk = voterSecretKey();
  const nullifier = disclose(computeNullifier(sk, sequence as Field as Bytes<32>));
  
  // Prevent double voting
  assert(!nullifierSet.member(nullifier), "You have already voted in this election");
  nullifierSet.insert(nullifier);
  
  // Validate and tally the vote
  const choice = disclose(candidateIndex);
  assert(choice == 0 || choice == 1, "Invalid candidate selection");
  
  if (choice == 0) {
    candidate0Tally.increment(1);
  } else {
    candidate1Tally.increment(1);
  }
  totalVotes.increment(1);
}

// Finalize the election and publish results on-chain
// DECENTRALIZED: Anyone can call this once the deadline has passed
// No owner check required — the time condition is the authority
export circuit finalizeElection(): [] {
  assert(state == State.OPEN, "Election is not open");
  
  // Time-based check: block time must be past the deadline
  // This makes finalization permissionless — anyone can trigger it after deadline
  assert(blockTimeGt(deadline), "Election deadline has not passed yet");
  
  // Compute and publish the winner on-chain
  if (candidate0Tally > candidate1Tally) {
    winner = Winner.CANDIDATE_A;
  } else if (candidate1Tally > candidate0Tally) {
    winner = Winner.CANDIDATE_B;
  } else {
    winner = Winner.TIE;
  }
  
  state = State.FINALIZED;
  sequence.increment(1);
}

// Owner can also force-finalize before deadline (for emergency)
export circuit ownerFinalizeElection(): [] {
  assert(state == State.OPEN, "Election is not open");
  assert(owner == voterPublicKey(voterSecretKey(), sequence as Field as Bytes<32>), "Not election owner");
  
  // Compute and publish the winner on-chain
  if (candidate0Tally > candidate1Tally) {
    winner = Winner.CANDIDATE_A;
  } else if (candidate1Tally > candidate0Tally) {
    winner = Winner.CANDIDATE_B;
  } else {
    winner = Winner.TIE;
  }
  
  state = State.FINALIZED;
  sequence.increment(1);
}

// --- Pure helper circuits ---

// DApp-specific public key — unlinkable across elections
export circuit voterPublicKey(sk: Bytes<32>, sequence: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "voting:pk:"), sequence, sk]);
}

// Nullifier — unique per voter per election round, unlinkable to identity
circuit computeNullifier(sk: Bytes<32>, sequence: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "voting:nul:"), sequence, sk]);
}
